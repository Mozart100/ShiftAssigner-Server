{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-postgres-and-build",
      "dependsOrder": "sequence",
      "dependsOn": [
        "start-postgres",
        "build"
      ]
    },
    {
      "label": "start-postgres",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Write-Host '🐘 Starting PostgreSQL Database...' -ForegroundColor Cyan; Write-Host '📋 Stopping existing postgres14 container...' -ForegroundColor Yellow; docker stop postgres14 2>$null; Write-Host '🗑️ Removing existing postgres14 container...' -ForegroundColor Yellow; docker rm postgres14 2>$null; Write-Host '🚀 Creating new PostgreSQL container...' -ForegroundColor Green; docker run --name postgres14 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=shiftassigner -p 5432:5432 -d postgres:14; Write-Host '✅ PostgreSQL is ready on port 5432!' -ForegroundColor Green"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/shift_assigner_server/ShiftAssignerServer/ShiftAssignerServer.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "clean-and-start-expo",
      "dependsOrder": "sequence",
      "dependsOn": [
        "kill-all-processes",
        "start-android-emulator",
        "wait-for-emulator",
        "install-expo-deps",
        "start-expo"
      ]
    },
    {
      "label": "kill-all-processes",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Write-Host '🧹 Cleaning all processes...' -ForegroundColor Cyan; taskkill /f /im 'qemu-system-x86_64.exe' 2>$null; taskkill /f /im 'emulator.exe' 2>$null; taskkill /f /im 'node.exe' 2>$null; Write-Host '✅ Processes cleaned!' -ForegroundColor Green"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "kill-server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Write-Host '🛑 Killing existing dotnet server processes...' -ForegroundColor Yellow; taskkill /f /im 'dotnet.exe' 2>$null; Write-Host '✅ Server processes killed!' -ForegroundColor Green"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "kill-and-start-server",
      "dependsOrder": "sequence",
      "dependsOn": [
        "kill-server",
        "start-postgres-and-build"
      ]
    },
    {
      "label": "start-emulator-and-expo",
      "dependsOrder": "sequence",
      "dependsOn": [
        "start-android-emulator",
        "wait-for-emulator",
        "install-expo-deps",
        "start-expo"
      ]
    },
    {
      "label": "start-android-emulator",
      "type": "shell",
      "command": "emulator",
      "args": ["-avd", "Pixel_4"],
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*emulator.*",
          "endsPattern": ".*boot completed.*|.*Ignore IPv6.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "wait-for-emulator",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Write-Host '⏳ Waiting 10 seconds for emulator to boot...' -ForegroundColor Yellow; Start-Sleep -Seconds 10; Write-Host '✅ Ready to start Expo!' -ForegroundColor Green"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "wait-for-server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Write-Host '⏳ Waiting 5 seconds for server to start...' -ForegroundColor Yellow; Start-Sleep -Seconds 5; Write-Host '✅ Server ready, starting client!' -ForegroundColor Green"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "install-expo-deps",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/shift_assigner_client"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "start-expo",
      "type": "shell",
      "command": "npm",
      "args": ["run", "android"],
      "options": {
        "cwd": "${workspaceFolder}/shift_assigner_client"
      },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting.*",
          "endsPattern": ".*Expo.*started.*|.*Metro.*ready.*"
        }
      }
    }
  ]
}