{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch ShiftAssignerServer",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "start-postgres-and-build",
      "program": "${workspaceFolder}/shift_assigner_server/ShiftAssignerServer/bin/Debug/net8.0/ShiftAssignerServer.dll",
      "args": [],
      "cwd": "${workspaceFolder}/shift_assigner_server/ShiftAssignerServer",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole"
    },
    {
      "name": "Client - Launch ShiftAssigner",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "clean-and-start-expo",
      "program": "${workspaceFolder}/shift_assigner_client/node_modules/@expo/cli/build/bin/cli",
      "args": ["start", "--android"],
      "cwd": "${workspaceFolder}/shift_assigner_client",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "DEBUG: Client - Mobile App",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "clean-and-start-expo",
      "program": "${workspaceFolder}/shift_assigner_client/node_modules/@expo/cli/build/bin/cli",
      "args": ["start", "--android"],
      "cwd": "${workspaceFolder}/shift_assigner_client",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development",
        "DEBUG": "expo:*",
        "EXPO_DEBUG": "1"
      },
      "skipFiles": ["<node_internals>/**"],
      "outputCapture": "console",
      "trace": "verbose"
    },
    {
      "name": "Client - Launch ShiftAssigner (Delayed)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "wait-for-server",
      "program": "${workspaceFolder}/shift_assigner_client/node_modules/@expo/cli/build/bin/cli",
      "args": ["start", "--android"],
      "cwd": "${workspaceFolder}/shift_assigner_client",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Launch Full Stack (Server + Client)",
      "configurations": [
        "Launch ShiftAssignerServer",
        "Client - Launch ShiftAssigner (Delayed)"
      ],
      "stopAll": true,
      "presentation": {
        "order": 1
      }
    }
  ]
}