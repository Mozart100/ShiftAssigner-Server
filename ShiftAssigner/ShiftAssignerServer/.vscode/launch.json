{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch ShiftAssignerServer (Debug DLL)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "start-postgres-and-build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/ShiftAssignerServer.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Launch Server & Run Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "start-postgres-and-build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/ShiftAssignerServer.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "postDebugTask": "run-tests"
    },
    {
      "name": "Run Tests Only",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/../ShiftAssignerServerTests/ShiftAssignerServer.Tests.csproj",
        "--logger",
        "console;verbosity=detailed"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Launch (dotnet run)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/ShiftAssignerServer.csproj",
        "--urls",
        "https://localhost:7083;http://localhost:5041"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
      ,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "Attach to Process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
    ,
    {
      "name": "Attach to .NET in Docker (shiftassigner)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [ "exec", "-i", "shiftassigner", "sh", "-c" ],
        "debuggerPath": "/remote/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src": "${workspaceFolder}",
        "/app": "${workspaceFolder}"
      }
    }
  ]
}
